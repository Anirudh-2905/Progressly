# Reference only: do not put real secrets in this committed file.
# Local development defaults to backend/learning_tracker.db, so no .env is required.
# The backend reads process environment variables; it does not automatically load
# this root file. Render supplies the production variables directly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Render sets these values through render.yaml.
REQUIRE_DATABASE_URL=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
